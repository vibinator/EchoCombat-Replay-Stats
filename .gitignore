# Only the application goes to GitHub: no replay data, database, generated files or reference material.

# Raw and derived data (replays, database, position tracks, exports)
/data/
*.echoreplay
*.ecrreplay
*.db
*.db-wal
*.db-shm
*.sqlite
tracks.bin
tracks3d.bin
# the bounds editor's overlay (where players are), written by bounds_editor.bat from the data folder
/app/tools/bounds_editor/data.js
/tests/sample-replays/

# Reference material from the old site (read-only, not ours to publish). The other files in docs/reference/ are this
# app's own code maps (docs/reference/README.md, 2026-11-07) and are uploaded.
/docs/reference/minimaps/
/docs/reference/echocombat-extract.md
/docs/reference/gear-table.json

# Environments, dependencies and build output (recreated by run.bat)
/.venv/
node_modules/
/app/frontend/dist/
*.tsbuildinfo
__pycache__/
*.pyc
.pytest_cache/

# Local / editor files
.env
settings.local.bat
*.log
.vscode/
.idea/
Thumbs.db
desktop.ini
